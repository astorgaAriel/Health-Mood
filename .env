# Configuración de Base de Datos PostgreSQL para Neon Cloud
DATABASE_URL=postgresql://[username]:[password]@[host]/[database]?sslmode=require
DB_USERNAME=[tu_usuario_neon]
DB_PASSWORD=[tu_password_neon]

# Configuración para desarrollo local (PostgreSQL local)
# DB_URL_LOCAL=jdbc:postgresql://localhost:5432/health_mood
# DB_USERNAME_LOCAL=postgres
# DB_PASSWORD_LOCAL=tu_password_local

# Configuración JWT
JWT_SECRET=tu_jwt_secret_key_muy_segura_aqui_para_produccion

# Configuración del servidor
SERVER_PORT=8080
PORT=8080

# Configuración de Spring Profile
SPRING_PROFILES_ACTIVE=cloud
